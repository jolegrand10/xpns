# Copy this file to .env and fill in the real values.
# .env is ignored by git — never commit credentials.
LOUTY_URL=https://appli.louty.net/Louty/content
LOUTY_USERNAME=
LOUTY_PASSWORD=

# Folder holding the monthly expense folders (YYYY-MM). The folder
# selection dialog opens there. Optional: defaults to the home folder.
XPNS_DATA_DIR=
